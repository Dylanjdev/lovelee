VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Stripe test keys. Only variables beginning with VITE_ are sent to the browser.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_server_secret_key
CHECKOUT_MODE=sandbox

# Server-only Odoo connection used by the checkout quotation endpoint.
ODOO_URL=https://your-company.odoo.com
ODOO_API_KEY=your-rpc-api-key
