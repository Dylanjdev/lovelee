{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lovelee",
  "compatibility_date": "2026-08-09",
  "main": "worker/index.js",
  "vars": {
    "ODOO_URL": "https://lovelee.odoo.com"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
